# ============================================================
# ARCFORM — Premium Streetwear E-Commerce Platform
# .gitignore
# ============================================================

# ─────────────────────────────────────────
# Python / Django
# ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Environment variables (never commit secrets!)
.env
.env.local
.env.*.local
.env.production

# Django
db.sqlite3
*.log
local_settings.py

# Migrations (comment out if you want to track migrations)
# migrations/

# Collected static files
backend/staticfiles/
backend/static_root/

# Media uploads (user-uploaded content)
backend/media/

# ─────────────────────────────────────────
# Frontend / Node (if using any tooling)
# ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/

# ─────────────────────────────────────────
# OS generated files
# ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─────────────────────────────────────────
# IDE / Editor
# ─────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─────────────────────────────────────────
# Testing
# ─────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
*.cover
.tox/

# ─────────────────────────────────────────
# Misc
# ─────────────────────────────────────────
*.bak
*.tmp
*.orig
